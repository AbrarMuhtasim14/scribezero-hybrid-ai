# Copy to .env.local (never commit .env.local or any secret/token values!)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Production Firebase App Check reCAPTCHA v3 or Enterprise Site Key
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Local Development ONLY (never commit, never ship to production)
# Leave blank for Firebase to print an auto-generated debug token in browser DevTools,
# or set your locally registered App Check debug token UUID:
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
